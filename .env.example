# ══════════════════════════════════════════════════════════════════
#  JuriCréances — Variables d'environnement
#  ⚠ NE JAMAIS commiter le fichier .env.local dans Git !
#  ⚠ Utiliser des clés TEST (sk_test_, pk_test_) en développement
# ══════════════════════════════════════════════════════════════════

# ─── STRIPE ───────────────────────────────────────────────────────
# ⚠ En dev : utiliser sk_test_ et pk_test_ (jamais sk_live_ ici)
STRIPE_SECRET_KEY=sk_test_REMPLACER_PAR_VOTRE_CLE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REMPLACER_PAR_VOTRE_CLE
STRIPE_WEBHOOK_SECRET=whsec_REMPLACER_PAR_VOTRE_SECRET

# ─── SUPABASE ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE_PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REMPLACER
SUPABASE_SERVICE_ROLE_KEY=REMPLACER

# ─── ANTHROPIC CLAUDE API ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-REMPLACER
CLAUDE_MODEL=claude-sonnet-4-6

# ─── YOUSIGN ──────────────────────────────────────────────────────
YOUSIGN_API_KEY=REMPLACER
YOUSIGN_SANDBOX=true
YOUSIGN_WEBHOOK_SECRET=REMPLACER

# ─── AR24 (LRAR — Lettre Postale uniquement) ─────────────────────
AR24_API_KEY=REMPLACER
AR24_API_SECRET=REMPLACER
AR24_SENDER_ID=REMPLACER
AR24_WEBHOOK_SECRET=REMPLACER
AR24_ENV=sandbox

# ─── BREVO (emails) ──────────────────────────────────────────────
BREVO_API_KEY=REMPLACER
BREVO_SENDER_EMAIL=contact@juricreances.fr
BREVO_SENDER_NAME=JuriCreances

# ─── VERCEL BLOB ──────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=REMPLACER

# ─── ADMINISTRATION ──────────────────────────────────────────────
# Email du compte admin (Supabase Auth — plus de mot de passe en clair)
MAITRE_EMAIL=karim.djaraouane@gmail.com

# ─── SITE ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://juricreances.fr
