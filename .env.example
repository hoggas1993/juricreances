# ─── STRIPE ───────────────────────────────────────────────────────────────────
# Clés disponibles sur dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Secret du webhook (dans Stripe > Developers > Webhooks > votre endpoint)
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── AIRTABLE ─────────────────────────────────────────────────────────────────
# API Key : airtable.com/account > API
AIRTABLE_API_KEY=pat...
# Base ID : visible dans l'URL de votre base (appXXXXXXXX)
AIRTABLE_BASE_ID=appXXXXXXXX
# Nom exact de la table dans Airtable
AIRTABLE_TABLE_NAME=Dossiers

# ─── YOUSIGN ──────────────────────────────────────────────────────────────────
# Clé API YouSign v3 : app.yousign.com → Paramètres → API
YOUSIGN_API_KEY=ys_...
# Mettre à 'true' pour utiliser l'environnement sandbox (tests)
YOUSIGN_SANDBOX=false

# ─── VERCEL BLOB ──────────────────────────────────────────────────────────────
# Généré automatiquement lors du premier déploiement Vercel avec Blob activé.
# Dans Vercel : Storage → Blob → Create Store → copier le token ici.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ─── MAKE.COM ─────────────────────────────────────────────────────────────────
# Webhook Scénario 1 : déclenché après paiement Stripe
# → Envoie email bienvenue client (avec lien_depot_pieces) + email Maître (avec MEC)
MAKE_WEBHOOK_NOUVEAU_DOSSIER=https://hook.eu2.make.com/...
# Webhook Scénario 2 : déclenché après validation Maître
# → Envoi AR24 + notification client
MAKE_WEBHOOK_VALIDATION=https://hook.eu2.make.com/...
# Webhook Scénario 3 (optionnel) : déclenché quand le client dépose ses pièces
# → Notification Maître "Pièces reçues pour le dossier JC-XXXX"
MAKE_WEBHOOK_PIECES_RECUES=https://hook.eu2.make.com/...

# ─── TABLEAU DE BORD MAÎTRE ───────────────────────────────────────────────────
# Mot de passe pour accéder à /validation
VALIDATION_PASSWORD=choisissez_un_mot_de_passe_fort

# ─── SITE ─────────────────────────────────────────────────────────────────────
# URL publique du site (sans slash final)
NEXT_PUBLIC_SITE_URL=https://juricreances.fr
